{
  "manifest": "1",
  "version": "1.0.2",
  "client_id": "2042866542",
  "callback_url": "https://codoplex.com/wpwa_phase_one/?pr_id=1557", 
  "oauth_final_destination": "editor",
  "scopes": ["read:site", "write:site"],
  "locale": "",
  "elements": [
    {
      "name": "Colored Lines",
      "path": "files",
      "version": "1.0.2",
      "settings": {
        "config": {
          "autopop": true
        },
        "properties": [
          {
            "name": "general-settings",
            "label": "General Settings",
            "type": "group",
            "properties": [
              {
                "name": "lineWidth",
                "label": "Line Width (%)",
                "type": "int",
                "default": 100,
                "step": 1,
                "min": 1,
                "tooltip": "Define line divider width in percentage e.g 50%"
              },
              {
                "name": "lineHeight",
                "label": "Line Height (px)",
                "type": "int",
                "default": 1,
                "step": 1,
                "min": 1,
                "tooltip": "Define line divider height (px)"
              },
              {
                "name": "lineColor",
                "label": "Line Color",
                "type": "color",
                "default": "#000",
                "tooltip": "Select the line divider color"
              }
            ]
          },
          {
            "name": "advanced-settings",
            "label": "Advanced Settings",
            "type": "group",
            "properties": [
              {
                "name": "lineAlignment",
                "label": "Line Alignment",
                "type": "align",
                "default": "left",
                "tooltip": "Select line divider alignment" 
              },
              {
                "name": "topMargin",
                "label": "Top Margin",
                "type": "int",
                "default": 5,
                "step": 1,
                "min": 0,
                "tooltip": "Define top margin (px)"
              },
              {
                "name": "bottomMargin",
                "label": "Bottom Margin",
                "type": "int",
                "default": 5,
                "step": 1,
                "min": 0,
                "tooltip": "Define bottom margin (px)"
              }

            ]
          }
          
        ]

      }
    }
  ]
}