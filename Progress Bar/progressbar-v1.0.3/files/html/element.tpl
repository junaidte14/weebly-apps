<div class="meter animate" id="codo-progress-{{progressId}}" style="height: {{progressHeight}}px; background: {{progressBgColor}}; -moz-border-radius: {{borderRadius}}px; -webkit-border-radius: {{borderRadius}}px; border-radius: {{borderRadius}}px;margin-bottom: 10px;">
	<div class="barbg" style="width: {{progressPercentage}}%; border-radius: {{borderRadius}}px; background-color: {{progressColor}};">
		<div class="bartext" style="text-align: center; color: {{textColor}}; font-weight: bold;line-height: {{progressHeight}}px;">{{progressPercentage}}%</div>
	</div>
</div>