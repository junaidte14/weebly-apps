{
  "manifest": "1",
  "version": "1.0.0", 
  "client_id": "1718550826",
  "callback_url": "https://codoplex.com/wpwa_phase_one/?pr_id=3985",
  "oauth_final_destination": "editor",
  "scopes": ["read:site", "write:site"],
  "locale": "",
  "elements": [
    {
      "name": "Timeline",
      "path": "files",
      "version": "1.0.0",
      "settings": {
        "config": {
          "autopop": true
        },
        "properties": [
          {
            "name": "tm-general-settings",
            "label": "General Settings",
            "type": "group",
            "properties": [
              {
                "name": "numberOfElements",
                "label": "No of Elements",
                "type": "int",
                "default": 1,
                "step": 1,
                "min": 1,
                "tooltip": "Define number of elements"
              }
            ]
          },
          {
            "name": "tm-settings",
            "label": "Timeline Settings",
            "type": "group",
            "properties": [
              {
                "name": "tmBgColor",
                "label": "Timeline BG Color",
                "type": "color",
                "default": "#8d2424",
                "tooltip": "Define background color of Timeline"
              },
              {
                "name": "tmCenterlineBgColor",
                "label": "Center Line Color",
                "type": "color",
                "default": "#ffffff",
                "tooltip": "Define centeral line color"
              },
              {
                "name": "tmCircleBgColor",
                "label": "Border Color of Circles",
                "type": "color",
                "default": "#FF9F55",
                "tooltip": "Define border color of circular dots"
              },
              {
                "name": "tmContentBGColor",
                "label": "Content BG Color",
                "type": "color",
                "default": "#ffffff",
                "tooltip": "Define background color of content sections"
              }

            ]
          }
          
        ]

      }
    }
  ]
}