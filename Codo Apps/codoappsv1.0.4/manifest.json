    {
      "name": "Colored Lines",
      "path": "elements/elementA",
      "version": "1.0.3",
      "settings": {
        "config": {
          "autopop": true
        },
        "properties": [
          {
            "name": "general-settings",
            "label": "General Settings",
            "type": "group",
            "properties": [
              {
                "name": "lineWidth",
                "label": "Line Width (%)",
                "type": "int",
                "default": 100,
                "step": 1,
                "min": 1,
                "tooltip": "Define line divider width in percentage e.g 50%"
              },
              {
                "name": "lineHeight",
                "label": "Line Height (px)",
                "type": "int",
                "default": 1,
                "step": 1,
                "min": 1,
                "tooltip": "Define line divider height (px)"
              },
              {
                "name": "lineColor",
                "label": "Line Color",
                "type": "color",
                "default": "#000",
                "tooltip": "Select the line divider color"
              }
            ]
          },
          {
            "name": "advanced-settings",
            "label": "Advanced Settings",
            "type": "group",
            "properties": [
              {
                "name": "lineAlignment",
                "label": "Line Alignment",
                "type": "align",
                "default": "left",
                "tooltip": "Select line divider alignment" 
              },
              {
                "name": "topMargin",
                "label": "Top Margin",
                "type": "int",
                "default": 5,
                "step": 1,
                "min": 0,
                "tooltip": "Define top margin (px)"
              },
              {
                "name": "bottomMargin",
                "label": "Bottom Margin",
                "type": "int",
                "default": 5,
                "step": 1,
                "min": 0,
                "tooltip": "Define bottom margin (px)"
              }

            ]
          }
          
        ]

      }
    },
    {
      "name": "Multi Column Blog",
      "path": "elements/elementB",
      "version": "1.0.3",
      "settings": {
        "config": {
          "autopop": true
        },
        "properties": [
          {
            "name": "settings",
            "label": "Settings",
            "type": "group",
            "properties": [
              {
                "name": "blogcolumns",
                "label": "Blog Post Columns",
                "type": "select",
                "values" : [
                    "1",
                    "2",
                    "3"
                  ],
                "default": "1",
                "tooltip": "Select the number of blog post columns"
              },
              {
                "name" : "expand-posts-area",
                "label": "Expand Posts Area",
                "type" : "toggle",
                "default" : false,
                "tooltip": "Recommended for 3 columns layout"
              },
              {
                "name": "postStyle",
                "label": "Blog Post Style",
                "type": "select",
                "values" : [
                    "simple",
                    "card"
                  ],
                "default": "simple",
                "tooltip": "Select the blog post style"
              },
              {
                "name": "cardGap",
                "label": "Card Gap",
                "type": "int",
                "default": 10,
                "step": 1,
                "min": 0,
                "tooltip": "Define gap/space between cards"
              },
              {
                "name" : "custom-card-colors",
                "label": "Use Custom Card Colors",
                "type" : "toggle",
                "default" : false,
                "tooltip": "Select whether to use custom card colors defined below or to use default colors"
              },
              {
                "name": "cardBgColor",
                "label": "Post Card BG Color",
                "type": "color",
                "default": "#FEFEFE",
                "tooltip": "Select the card bg color,if Custom Card Colors is true"
              },
              {
                "name": "cardShadowColor",
                "label": "Post Card Shadow Color",
                "type": "color",
                "default": "#221919",
                "tooltip": "Select the card shadow color,if Custom Card Colors is true"
              },
              {
                "name": "cardBorderColor",
                "label": "Post Card Border Color",
                "type": "color",
                "default": "#FAFAFA",
                "tooltip": "Select the card border color,if Custom Card Colors is true"
              }
              
            ]
          }
          
        ]

      },
      "tutorial": {
        "introduction": "With Multi Column Blog app, you can convert your blog posts to multi column layout",
        "type": "steps",
        "content": [
          "Select the number of columns for blog posts: For example if you select 3 then your blog posts will be shown in 3 columns.",
          "Select whether to expand the posts area or not: True means that blog sidebar will appear under the blog posts.",
          "Select the style of blog posts: If you select 'simple' then blog posts will look as your theme design but if you select 'card' then your blog posts will look like cards with background color and shadow.",
          "Use Custom Card Colors: If true/enabled, it means that your defined card background color and card shadow color will be used. If false/disabled then default colors will be used."
        ],
        "autopop": true
      }
    },
