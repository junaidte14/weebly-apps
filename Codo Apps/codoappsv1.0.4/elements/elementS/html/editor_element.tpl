{{! Editor View Template }}
{{! No ID dependence in the content tag; all content visible. }}

<div class="codo-anim-container" 
    style="opacity: 1 !important;"
    data-color-style="{{colorStyle}}"
    data-fill-color="{{fillColor}}"
    data-grad-from="{{gradientFrom}}"
    data-grad-to="{{gradientTo}}">
    {codo_anim_content:content default="Add your content here — text, images, buttons, or any Weebly element."}
</div>