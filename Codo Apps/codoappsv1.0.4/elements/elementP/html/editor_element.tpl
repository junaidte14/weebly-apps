{{! Sticky Announcement Bar — Editor View }}

<div class="codo_abar_editor_preview">
    <div class="codo_abar_inner">
        <div class="codo_abar_content">
            {codo_abar_content:content default="Add your announcement here — text, links, buttons, anything."}
        </div>
    </div>
    {{#showClose}}
    <button class="codo_abar_close" aria-label="Close">&times;</button>
    {{/showClose}}
</div>
