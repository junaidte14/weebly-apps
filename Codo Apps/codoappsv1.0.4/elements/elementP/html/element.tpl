<div class="codo_abar_bar codo_abar_{{position}}"
     data-position="{{position}}"
     data-show-spacer="{{showSpacer}}"
     data-cookie-days="{{cookieDays}}">

    <div class="codo_abar_inner">
        <div class="codo_abar_content">
            {codo_abar_content:content default="Add your announcement here — text, links, buttons, anything."}
        </div>
    </div>
    {{#showClose}}
    <button class="codo_abar_close" aria-label="Close announcement">&times;</button>
    {{/showClose}}

</div>